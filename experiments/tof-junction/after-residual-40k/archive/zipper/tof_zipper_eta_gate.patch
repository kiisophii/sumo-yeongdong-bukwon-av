+def _ego_can_clear_first(ego_clear_s, other_distance, track):
+    # With missing tracks or no forward motion, leave the legacy hazard in place.
+    if (other_distance <= 0.0 or track.speed is None or track.speed <= 0.1
+            or track.acceleration is None or not isfinite(track.acceleration)):
+        return False
+    acceleration = max(0.0, track.acceleration)
+    # Solve d = v*t + 0.5*a*t^2 with a stable expression at a = 0.
+    arrival_s = 2.0 * other_distance / (
+        track.speed + sqrt(track.speed ** 2 + 2.0 * acceleration * other_distance)
+    )
+    return arrival_s - ego_clear_s >= ZIPPER_ETA_MARGIN_S
+
