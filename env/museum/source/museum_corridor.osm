    <tag k="historic" v="railway_car" />
    <tag k="inscription" v="디젤난방차는 증기발생기의 수관보일러에서 증기를 발생시켜 통일호 객차와 비둘기호 객차 난방관에 공급하는 차량입니다&#10;&#10;디젤기관, 증기발생기, 공기압축기, 발전기, 물탱크 등으로 구성되었고 1965년 한국기계(현 대우중공업 인천공장)에서 제작했고 1987년 4월 15일까지 동절기에 여객열차와 연결운행한 차량입니다." />
    <tag k="name" v="디젤난방차" />
    <tag k="name:ja" v="ディーゼル暖房車" />
  </way>
  <way id="829939501" visible="true" version="2" changeset="168786075" timestamp="2025-07-11T09:33:11Z" user="oruk09" uid="5200439">
